# Copiá este archivo a .env y completalo. El .env NO se sube a Git.

# Pinecone (plan gratuito): https://app.pinecone.io → API Keys
PINECONE_API_KEY=
INDEX_NAME=andespay-docs
PINECONE_NAMESPACE=dev

# Google AI Studio (gratis): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Opcionales (valores por defecto)
# EMBEDDING_PROVIDER=gemini          # gemini | openai
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536                 # tiene que coincidir con la dimensión del índice
# OPENAI_API_KEY=                    # solo si EMBEDDING_PROVIDER=openai
# LLM_MODEL=gemini-flash-latest      # solo para rag_system.py --responder
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80
# TOP_K=5
# BM25_WEIGHT=0.4
# SEMANTIC_WEIGHT=0.6
